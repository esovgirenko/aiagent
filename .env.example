APP_HOST=0.0.0.0
APP_PORT=8000
APP_TITLE=Multi-LLM AI Agent
DATABASE_URL=sqlite:///./data/agent.db
AUTH_PASSWORD=change-me
SESSION_SECRET=change-this-session-secret
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=change-me-now
RATE_LIMIT_PER_MINUTE=20
AUTONOMY_INTERVAL_SEC=20
AUTONOMY_MAX_ITERATIONS=20
AUTONOMY_FAIL_STREAK_LIMIT=3
AUTONOMY_IDLE_CYCLES_BEFORE_STOP=2
AUTONOMY_SUMMARY_INTERVAL_SEC=3600
AUTONOMY_REVIEWER_PROVIDER=openai
AUTONOMY_REVIEWER_ENABLED=true
AUTONOMY_SELF_EDIT_ENABLED=false
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama provider
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# GigaChat provider
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Preferred if your cabinet gives "API Authorization Key" directly.
GIGACHAT_AUTH_KEY=
# Alternative OAuth pair:
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_MODEL=GigaChat
